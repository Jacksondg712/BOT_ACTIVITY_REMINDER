# =============================================================================
# VARIABLES DE ENTORNO — BOT_ACTIVITY_REMINDER
# Copia este archivo como .env para desarrollo local.
# =============================================================================

# --- Salesforce (mismo esquema que BOT_ASSIG_LIDER) ---
# Opcion A - OAuth Password Flow (si se dejan vacios se usa SOAP)
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_BASE_URL=https://your-instance.my.salesforce.com
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_API_VERSION=v61.0

# --- Slack (Bot Token Scopes: chat:write, im:write, users:read, users:read.email) ---
SLACK_BOT_TOKEN=xoxb-...
# false = no envia nada a Slack (se comporta como --dry-run)
SLACK_NOTIFICATIONS_ENABLED=true
SLACK_TEST_CHANNEL_ID=

# --- Modo prueba ---
# true  = solo se procesan Ejecutivotest1..3; los mensajes van al canal de
#         pruebas + DM a Ejecutivotestsend1 (nunca al ejecutivo/lider real).
# false = produccion: ejecutivos segun executive_titles de reminder_config.json,
#         DM a cada uno y a su lider (Manager en Salesforce).
TEST_MODE=true
Ejecutivotest1=
Ejecutivotest2=
Ejecutivotest3=
Ejecutivotestsend1=

# Silencia los logs linea-por-linea de httpx/httpcore
QUIET_HTTP_LOGS=true
